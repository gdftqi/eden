[client]
default-character-set = utf8mb4

[mysqld]
# 基础配置
server-id=1
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci
bind-address = 0.0.0.0
datadir = /var/lib/mysql
socket = /var/lib/mysql/mysql.sock
init_connect = 'SET NAMES utf8mb4'
skip-name-resolve

# 二进制日志配置（主库必须开启）
read-only=0