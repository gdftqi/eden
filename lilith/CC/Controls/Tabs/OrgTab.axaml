<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:CC"
             x:Class="CC.OrgTab">
    <Grid ColumnDefinitions="280,*">
        <!-- 部门/员工列表 -->
        <cc:OrgListPanel x:Name="OrgPanel" Grid.Column="0"/>
        <!-- 右侧: 员工详情(后期填) -->
        <Border Grid.Column="1" Background="#ECE5DD">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Margin="40">
                <TextBlock Text="&#x201C;Let them hate, so long as they fear.&#x201D;" FontFamily="Georgia" FontSize="30" FontStyle="Italic" FontWeight="SemiBold" Foreground="#4B4B4B" TextAlignment="Center" TextWrapping="Wrap" LineHeight="44"/>
                <Border Height="1" Width="120" Background="#C9C9C9" Margin="0,22,0,14"/>
                <TextBlock Text="— Oderint dum metuant · Caligula" FontFamily="Georgia" FontSize="14" FontStyle="Italic" Foreground="#8A8A8A" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
