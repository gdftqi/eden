<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ChatItem"
             x:Name="Root">
    <Border Classes="item" Height="64" Padding="12,0" Background="Transparent">
        <Border.Styles>
            <Style Selector="Border.item:pointerover">
                <Setter Property="Background" Value="#F2F3F5"/>
            </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <!-- 头像 (圆角方) -->
            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                <Image Source="{Binding #Root.Avatar}" Stretch="UniformToFill"/>
            </Border>

            <!-- 右侧: 上(昵称 + 时间) / 下(最后一条消息) -->
            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding #Root.Nickname}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#1E1E1E"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding #Root.Time}"
                               FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding #Root.LastMessage}"
                           FontSize="12.5" Foreground="#8A9099"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
