<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ChatItem"
             x:Name="Root">
    <!-- 整项可聚焦(点击=选中); 去掉默认焦点虚线框 -->
    <Border Classes="item" Height="64" Padding="12,0" Focusable="True" FocusAdorner="{x:Null}">
        <Border.Styles>
            <!-- 基础背景用样式设(不要写成本地 Background, 否则会压住下面的状态样式) -->
            <Style Selector="Border.item">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <!-- hover: 淡灰 (仿 WhatsApp) -->
            <Style Selector="Border.item:pointerover">
                <Setter Property="Background" Value="#F2F3F5"/>
            </Style>
            <!-- 选中(focus): 淡绿, 比 hover 略深 -->
            <Style Selector="Border.item:focus">
                <Setter Property="Background" Value="#D9EDDA"/>
            </Style>
            <!-- 选中 + hover: 再略深一点 -->
            <Style Selector="Border.item:focus:pointerover">
                <Setter Property="Background" Value="#CFE8D1"/>
            </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <!-- 头像 (圆形) -->
            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" ClipToBounds="True" Margin="0,0,10,0">
                <Image Source="{Binding #Root.Avatar}" Stretch="UniformToFill"/>
            </Border>

            <!-- 右侧: 上(昵称 + 时间) / 下(最后一条消息) -->
            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding #Root.Nickname}" FontSize="14" FontWeight="SemiBold" Foreground="#1E1E1E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding #Root.Time}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <!-- 下行: 最后一条消息(左) + 未读角标(右) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding #Root.LastMessage}" FontSize="12.5" Foreground="#8A9099" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- 未读红点角标: 0 隐藏, >99 显示 99+ (由后端控制) -->
                    <Border Grid.Column="1" x:Name="Badge" Background="#F5333F" CornerRadius="9"
                            MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0"
                            VerticalAlignment="Center" IsVisible="False">
                        <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
