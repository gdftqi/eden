<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.EmojiPicker">
    <ScrollViewer Width="320" Height="240" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <ScrollViewer.Resources>
            <!-- 滚动条 -->
            <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Style Selector="^ /template/ Thumb">
                    <Setter Property="Background" Value="#C2C5CB"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="^ /template/ Thumb:pointerover">
                    <Setter Property="Background" Value="#A6AAB1"/>
                </Style>
                <Style Selector="^ /template/ Thumb:pressed">
                    <Setter Property="Background" Value="#8E939B"/>
                </Style>
                <Style Selector="^ /template/ RepeatButton.page">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Template">
                        <ControlTemplate><Border Background="{TemplateBinding Background}"/></ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="^:vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}">
                                <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton" Classes="page" Focusable="False"/>
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton" Classes="page" Focusable="False"/>
                                    </Track.IncreaseButton>
                                    <Thumb Width="6" HorizontalAlignment="Center" MinHeight="28"/>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ControlTheme>
        </ScrollViewer.Resources>
        <WrapPanel x:Name="Panel"/>
    </ScrollViewer>
</UserControl>
