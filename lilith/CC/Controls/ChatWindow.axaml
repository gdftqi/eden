<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ChatWindow"
             x:Name="Root">
    <Grid RowDefinitions="56,*,Auto">

        <!-- ============ 顶栏: 对方头像 + 名字 + 图标 ============ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E6E6E6" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding #Root.PeerAvatar}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding #Root.PeerName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E1E1E" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <StackPanel.Styles>
                        <Style Selector="Button.icon">
                            <Setter Property="Width" Value="38"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="19"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#11000000"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Classes="icon">
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="#555"
                              Data="M17,10.5V7c0-0.55-0.45-1-1-1H4C3.45,6,3,6.45,3,7v10c0,0.55,0.45,1,1,1h12c0.55,0,1-0.45,1-1v-3.5l4,4v-11L17,10.5z"/>
                    </Button>
                    <Button Classes="icon">
                        <Path Width="19" Height="19" Stretch="Uniform" Fill="#555"
                              Data="M6.62,10.79c1.44,2.83,3.76,5.14,6.59,6.59l2.2-2.2c0.27-0.27,0.67-0.36,1.02-0.24c1.12,0.37,2.33,0.57,3.57,0.57c0.55,0,1,0.45,1,1V20c0,0.55-0.45,1-1,1C10.07,21,3,13.93,3,5.5C3,4.95,3.45,4.5,4,4.5h3.5c0.55,0,1,0.45,1,1c0,1.25,0.2,2.45,0.57,3.57c0.11,0.35,0.03,0.74-0.25,1.02L6.62,10.79z"/>
                    </Button>
                    <Button Classes="icon">
                        <Path Width="20" Height="20" Stretch="Uniform" Fill="#555"
                              Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"/>
                    </Button>
                    <Button Classes="icon">
                        <StackPanel Spacing="3">
                            <Ellipse Width="3.6" Height="3.6" Fill="#555"/>
                            <Ellipse Width="3.6" Height="3.6" Fill="#555"/>
                            <Ellipse Width="3.6" Height="3.6" Fill="#555"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 消息区: 气泡挂载点 ============ -->
        <Border Grid.Row="1" Background="#ECE5DD">
            <ScrollViewer x:Name="MsgScroll" Padding="16,12" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <!-- 细圆角滑块滚动条(同会话列表那条) -->
                    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style Selector="^ /template/ Thumb">
                            <Setter Property="Background" Value="#9AA39A"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="^ /template/ Thumb:pointerover">
                            <Setter Property="Background" Value="#7E877E"/>
                        </Style>
                        <Style Selector="^ /template/ RepeatButton.page">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <ControlTemplate><Border Background="{TemplateBinding Background}"/></ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="^:vertical">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}">
                                        <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               ViewportSize="{TemplateBinding ViewportSize}"
                                               Value="{TemplateBinding Value, Mode=TwoWay}">
                                            <Track.DecreaseButton>
                                                <RepeatButton Name="PART_PageUpButton" Classes="page" Focusable="False"/>
                                            </Track.DecreaseButton>
                                            <Track.IncreaseButton>
                                                <RepeatButton Name="PART_PageDownButton" Classes="page" Focusable="False"/>
                                            </Track.IncreaseButton>
                                            <Thumb Width="6" HorizontalAlignment="Center" MinHeight="28"/>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                    </ControlTheme>
                </ScrollViewer.Resources>
                <StackPanel x:Name="MessageList" Spacing="2"/>
            </ScrollViewer>
        </Border>

        <!-- ============ 输入栏 ============ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E6E6E6" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,8" ColumnSpacing="4">
                <Grid.Styles>
                    <Style Selector="Button.tool">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="20"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#11000000"/>
                    </Style>
                </Grid.Styles>

                <!-- 加号(附件/文件) -->
                <Button Grid.Column="0" Classes="tool">
                    <Path Width="20" Height="20" Stroke="#666" StrokeThickness="1.8" StrokeLineCap="Round"
                          Data="M10,4 V16 M4,10 H16"/>
                </Button>
                <!-- 表情 -->
                <Button Grid.Column="1" Classes="tool">
                    <Path Width="21" Height="21" Stretch="Uniform" Stroke="#666" StrokeThickness="1.3" Fill="Transparent"
                          StrokeLineCap="Round"
                          Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M8,14 Q12,17.5 16,14 M9,9.5 V10.3 M15,9.5 V10.3"/>
                </Button>
                <!-- 输入框 -->
                <Border Grid.Column="2" Background="#F0F2F5" CornerRadius="20" VerticalAlignment="Center" MinHeight="40">
                    <TextBox x:Name="InputBox" PlaceholderText="输入消息" Background="Transparent"
                             BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"
                             Padding="14,8" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap"/>
                </Border>
                <!-- 发送 -->
                <Button Grid.Column="3" Classes="send" Click="Send_Click">
                    <Button.Styles>
                        <Style Selector="Button.send">
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="20"/>
                            <Setter Property="Background" Value="#43A047"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button.send:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#4CAF50"/>
                        </Style>
                    </Button.Styles>
                    <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                          Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
