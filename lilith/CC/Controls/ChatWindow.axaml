<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ChatWindow"
             x:Name="Root">
    <Grid RowDefinitions="56,*,Auto">

        <!-- ============ 顶栏: 对方头像 + 名字 + 图标 ============ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E6E6E6" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True">
                        <Image Source="{Binding #Root.PeerAvatar}" Stretch="UniformToFill"/>
                    </Border>
                    <!-- 昵称(上) + 最后在线(下, 小灰字) -->
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding #Root.PeerName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#1E1E1E"/>
                        <TextBlock Text="{Binding #Root.PeerStatus}" FontSize="12" Foreground="#667781"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel.Styles>
                        <Style Selector="Button.icon">
                            <Setter Property="Width" Value="38"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="19"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#11000000"/>
                        </Style>
                    </StackPanel.Styles>
                    <!-- 视频 videocam: 机身镂空 + 实心镜头 -->
                    <Button Classes="icon">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4zM15 16H5V8h10v8z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 电话 call: 实心听筒 -->
                    <Button Classes="icon">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 搜索 search: 镂空圆 + 把手 -->
                    <Button Classes="icon">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 菜单 more_vert: 三个点, 点击弹出下拉 -->
                    <Button Classes="icon">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="加为联系人" Click="AddContact_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Width="19" Height="19">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#555" Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="清空聊天" Click="ClearChat_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Width="19" Height="19">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#555" Data="M7 11v2h10v-2H7zm5-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="删除对话" Click="DeleteChat_Click" Foreground="#E5484D">
                                    <MenuItem.Icon>
                                        <Viewbox Width="19" Height="19">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#E5484D" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 消息区: 气泡挂载点 ============ -->
        <Border Grid.Row="1" Background="#ECE5DD">
            <ScrollViewer x:Name="MsgScroll" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <!-- 细圆角滑块滚动条(同会话列表那条) -->
                    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style Selector="^ /template/ Thumb">
                            <Setter Property="Background" Value="#9AA39A"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="^ /template/ Thumb:pointerover">
                            <Setter Property="Background" Value="#7E877E"/>
                        </Style>
                        <Style Selector="^ /template/ RepeatButton.page">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <ControlTemplate><Border Background="{TemplateBinding Background}"/></ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="^:vertical">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}">
                                        <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               ViewportSize="{TemplateBinding ViewportSize}"
                                               Value="{TemplateBinding Value, Mode=TwoWay}">
                                            <Track.DecreaseButton>
                                                <RepeatButton Name="PART_PageUpButton" Classes="page" Focusable="False"/>
                                            </Track.DecreaseButton>
                                            <Track.IncreaseButton>
                                                <RepeatButton Name="PART_PageDownButton" Classes="page" Focusable="False"/>
                                            </Track.IncreaseButton>
                                            <Thumb Width="6" HorizontalAlignment="Center" MinHeight="28"/>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                    </ControlTheme>
                </ScrollViewer.Resources>
                <!-- 外层至少占满视口高度(绑稳定的 Bounds.Height, 不绑 Viewport 免循环);
                     消息靠底对齐: 少时贴底, 多时正常滚。内边距挪到 StackPanel 的 Margin。 -->
                <Panel MinHeight="{Binding #MsgScroll.Bounds.Height}">
                    <StackPanel x:Name="MessageList" Spacing="2" VerticalAlignment="Bottom" Margin="16,12"/>
                </Panel>
            </ScrollViewer>
        </Border>

        <!-- ============ 输入栏: 浮动白胶囊(加号 表情 文本 发送, 两端圆); focus 时整条变绿边 ============ -->
        <Border Grid.Row="2" Background="#ECE5DD">
            <Border Classes="inputpill" Margin="12,8" MinHeight="44" Padding="6,2,5,2">
                <Border.Styles>
                    <Style Selector="Border.inputpill">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="24"/>
                        <Setter Property="BoxShadow" Value="0 1 2 0 #12000000"/>
                    </Style>
                    <!-- focus 时整个胶囊高亮(绿边), 仿搜索栏 -->
                    <Style Selector="Border.inputpill:focus-within">
                        <Setter Property="BorderBrush" Value="#43A047"/>
                    </Style>
                    <!-- 胶囊里的小图标按钮 -->
                    <Style Selector="Button.tool">
                        <Setter Property="Width" Value="38"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="19"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                    </Style>
                    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#0F000000"/>
                    </Style>
                    <!-- 发送圆 -->
                    <Style Selector="Button.send">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="CornerRadius" Value="20"/>
                        <Setter Property="Background" Value="#43A047"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                    </Style>
                    <Style Selector="Button.send:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#4CAF50"/>
                    </Style>
                    <!-- 去掉 TextBox 自带内框 + 聚焦/悬停时的蓝色边框 -->
                    <Style Selector="TextBox /template/ Border#PART_BorderElement">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Border.Styles>

                <!-- Grid 撑满胶囊高度, 三个按钮钉在底部, 输入框变高时它们不上移 -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <!-- 加号 -->
                    <Button Grid.Column="0" Classes="tool">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#555" StrokeThickness="2" StrokeLineCap="Round" Fill="Transparent"
                                      Data="M12 5 V19 M5 12 H19"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 表情: 点击弹出 emoji 选择(内容在代码里建并塞进 Flyout) -->
                    <Button Grid.Column="1" x:Name="EmojiBtn" Classes="tool">
                        <Button.Flyout>
                            <Flyout Placement="Top"/>
                        </Button.Flyout>
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 输入框 -->
                    <TextBox Grid.Column="2" x:Name="InputBox" PlaceholderText="输入消息" Background="Transparent"
                             BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"
                             Padding="6,9" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <!-- 发送: 绿圆 + > (90° 角) -->
                    <Button Grid.Column="3" Classes="send" Click="Send_Click" Margin="4,0,0,0">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      Data="M9.5 7 L14.5 12 L9.5 17"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
