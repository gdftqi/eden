<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CC.MainWindow"
        Title="cc"
        MinWidth="1000" MinHeight="580"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Border CornerRadius="8" ClipToBounds="True">
    <Grid>
        <!-- 主内容 -->
        <Grid RowDefinitions="38,*" ColumnDefinitions="60,280,*">
            <!-- TopBar -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3" PointerPressed="TopBar_PointerPressed">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#1B5E20" Offset="0"/>
                        <GradientStop Color="#66BB6A" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <!-- LOGO: 白色气泡轮廓(空心) + 白色 x -->
                    <Viewbox Width="34" Height="34">
                        <Canvas Width="32" Height="32">
                            <Viewbox Canvas.Left="4" Canvas.Top="4" Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="White" StrokeThickness="2" StrokeJoin="Round" Data="M12,3 C7,3 3,6.5 3,11 C3,13 3.8,14.8 5.2,16.2 L3,21 L8.2,19.5 C9.3,19.8 10.6,20 12,20 C17,20 21,16.5 21,12 C21,7.5 17,3 12,3 Z"/>
                                    <Path Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" Data="M9.5,9 L14.5,14 M14.5,9 L9.5,14"/>
                                </Canvas>
                            </Viewbox>
                        </Canvas>
                    </Viewbox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Styles>
                        <!-- 平时透明无背景, 只有 hover 才显灰 -->
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Click="Minimize_Click">
                        <Path Width="16" Height="16" Stroke="White" StrokeThickness="1" Data="M0,8 H16"/>
                    </Button>
                    <Button Click="Maximize_Click">
                        <Path x:Name="MaxIcon" Width="16" Height="16" Stroke="White" StrokeThickness="1" Fill="Transparent" Data="M1,1 H15 V15 H1 Z"/>
                    </Button>
                    <Button Click="Button_Click">
                        <Path Width="16" Height="16" Stroke="White" StrokeThickness="1" Data="M1,1 L15,15 M15,1 L1,15"/>
                    </Button>
                </StackPanel>
            </Grid>
            <!-- 导航栏 -->
            <Border Grid.Row="1" Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#3E3E3E" Offset="0"/>
                        <GradientStop Color="#1E1E1E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                <!-- 顶部: 聊天 + 组织架构 (竖直, 居中靠顶) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="6">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Width" Value="44"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                        </Style>
                    </StackPanel.Styles>
                    <!-- 聊天 -->
                    <Button Click="Chat_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="ChatIcon" Fill="#66BB6A" Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 联系人列表 -->
                    <Button Click="Contacts_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="ContactsIcon" Fill="White" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 组织架构 -->
                    <Button Click="Org_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="OrgIcon" Fill="White" Data="M22 11V3h-7v3H9V3H2v8h7V8h2v10h4v3h7v-8h-7v3h-2V8h2v3z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- 底部: 设置齿轮 + 用户头像 (竖直, 居中靠底) -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Spacing="12">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                        </Style>
                    </StackPanel.Styles>

                    <!-- 设置按钮 (齿轮) -->
                    <Button Click="Settings_Click" Width="44" Height="44">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="SettingsIcon" Fill="White" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 用户头像 (圆形): 真实图片, ClipToBounds+CornerRadius 裁成圆 -->
                    <Border Width="42" Height="42" CornerRadius="21" ClipToBounds="True">
                        <Image Source="/Resources/unnamed.jpg" Stretch="UniformToFill"/>
                    </Border>
                </StackPanel>
                </Grid>
            </Border>
            <!-- 用户/会话列表 -->
            <Border Grid.Row="1" Grid.Column="1" Background="#F5F5F5"/>
            <!-- 聊天区 -->
            <Border Grid.Row="1" Grid.Column="2" Background="#FEFEFE"/>
        </Grid>

        <!-- 鼠标缩放窗体: 边缘/四角透明拖拽区 (无边框窗口需手动 BeginResizeDrag); 角在边之后, 上层优先 -->
        <Rectangle VerticalAlignment="Top"    HorizontalAlignment="Stretch" Height="6" Margin="6,0" Fill="Transparent" Cursor="SizeNorthSouth"   Tag="North"     PointerPressed="Resize_PointerPressed"/>
        <Rectangle VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="6" Margin="6,0" Fill="Transparent" Cursor="SizeNorthSouth"   Tag="South"     PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Left"  VerticalAlignment="Stretch" Width="6" Margin="0,6"  Fill="Transparent" Cursor="SizeWestEast"     Tag="West"      PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Margin="0,6"  Fill="Transparent" Cursor="SizeWestEast"     Tag="East"      PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Left"  VerticalAlignment="Top"    Width="10" Height="10" Fill="Transparent" Cursor="TopLeftCorner"     Tag="NorthWest" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top"    Width="10" Height="10" Fill="Transparent" Cursor="TopRightCorner"    Tag="NorthEast" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Left"  VerticalAlignment="Bottom" Width="10" Height="10" Fill="Transparent" Cursor="BottomLeftCorner"  Tag="SouthWest" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10" Fill="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="Resize_PointerPressed"/>
    </Grid>
    </Border>
</Window>
