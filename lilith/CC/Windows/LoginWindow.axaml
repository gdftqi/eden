<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="300"
        x:Class="CC.LoginWindow"
        Title="登录"
        Width="440" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Border CornerRadius="8" ClipToBounds="True">
        <!-- 整窗深灰渐变 (与主界面左侧菜单栏同款), TOP 栏融进背景, 不再是独立绿条 -->
        <Grid RowDefinitions="38,*">
            <Grid.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#1E1E1E" Offset="0"/>
                    <GradientStop Color="#3E3E3E" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- TOP 栏: 透明露出渐变, 可拖; 左 LOGO, 右 关闭 -->
            <Grid Grid.Row="0" Background="Transparent" PointerPressed="TopBar_PointerPressed">
                <!-- LOGO (与主界面同款: 白色气泡轮廓 + 白 x) -->
                <Viewbox Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                    <Canvas Width="32" Height="32">
                        <Viewbox Canvas.Left="4" Canvas.Top="4" Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="White" StrokeThickness="2" StrokeJoin="Round" Data="M12,3 C7,3 3,6.5 3,11 C3,13 3.8,14.8 5.2,16.2 L3,21 L8.2,19.5 C9.3,19.8 10.6,20 12,20 C17,20 21,16.5 21,12 C21,7.5 17,3 12,3 Z"/>
                                <Path Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" Data="M9.5,9 L14.5,14 M14.5,9 L9.5,14"/>
                            </Canvas>
                        </Viewbox>
                    </Canvas>
                </Viewbox>
                <!-- 关闭按钮 (hover 红底) -->
                <Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="40" Height="38" Padding="0" CornerRadius="0" Background="Transparent">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#E81123"/>
                        </Style>
                    </Button.Styles>
                    <Path Width="16" Height="16" Stroke="White" StrokeThickness="1" Data="M1,1 L15,15 M15,1 L1,15"/>
                </Button>
            </Grid>

            <!-- 表单: 收窄居中, 贴在下半部分 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Width="230" Margin="0,0,0,26">
                <StackPanel.Styles>
                    <Style Selector="TextBox">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="9,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style Selector="Button.login">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="#2E7D32"/>
                    </Style>
                    <Style Selector="Button.login:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#388E3C"/>
                    </Style>
                    <Style Selector="Button.login:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#1B5E20"/>
                    </Style>
                </StackPanel.Styles>

                <!-- 用户名 / 密码 -->
                <StackPanel Spacing="10">
                    <TextBox x:Name="UserBox" Watermark="用户名"/>
                    <TextBox x:Name="PassBox" Watermark="密码" PasswordChar="●"/>
                </StackPanel>

                <!-- 错误提示 (默认隐藏) -->
                <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12"
                           Margin="2,8,0,0" IsVisible="False"/>

                <!-- 记住密码 -->
                <CheckBox Content="记住密码" FontSize="12" Foreground="#BDBDBD" Margin="0,10,0,0"/>

                <!-- 登录 (Enter 键也触发) -->
                <Button Classes="login" Content="登 录" Click="Login_Click" IsDefault="True" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
