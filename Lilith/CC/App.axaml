<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- 托盘图标: 关闭主窗只是收起来, 程序还活着(消息照收), 真退出走这里的菜单 -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Resources/app.ico" ToolTipText="CC" Clicked="Tray_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="打开主界面" Click="TrayOpen_Click"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="退出" Click="TrayExit_Click"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>