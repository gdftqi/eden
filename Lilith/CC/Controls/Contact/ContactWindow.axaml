<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ContactWindow">
    <UserControl.Styles>
            <!-- 通用选项行: 整行可点, 悬停变灰 -->
            <Style Selector="Button.opt">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="22,13"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style Selector="Button.opt:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#F5F5F5"/>
            </Style>
            <!-- 圆形动作按钮(语音/视频/搜索) -->
            <Style Selector="Button.act">
                <Setter Property="Width" Value="56"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="CornerRadius" Value="28"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.act:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#E4E6E9"/>
            </Style>
            <!-- 分组分隔线 -->
            <Style Selector="Border.sep">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="#ECECEC"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>
    </UserControl.Styles>

    <!-- 联系人详情页: 头像/昵称/手机号(可多个)/操作按钮/影音内容/选项行/危险操作 -->
    <Grid Background="White" RowDefinitions="56,*">
        <!-- 头部: 关闭 + 标题 + 编辑 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,0">
            <Grid.Styles>
                <Style Selector="Button">
                    <Setter Property="Width" Value="40"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="CornerRadius" Value="20"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#11000000"/>
                </Style>
            </Grid.Styles>
            <Button Grid.Column="0" Click="Close_Click" VerticalAlignment="Center">
                <Path Width="14" Height="14" Stroke="#333" StrokeThickness="1.8" StrokeLineCap="Round" Data="M1,1 L13,13 M13,1 L1,13"/>
            </Button>
            <TextBlock Grid.Column="1" Text="联系人信息" FontSize="16" FontWeight="SemiBold" Foreground="#1E1E1E" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button Grid.Column="2" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#333" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,24">
                <!-- 头像 -->
                <Border Width="160" Height="160" CornerRadius="80" ClipToBounds="True" HorizontalAlignment="Center">
                    <Image x:Name="FaceImg" Stretch="UniformToFill"/>
                </Border>

                <!-- 昵称 -->
                <TextBlock x:Name="NickText" Text="昵称" FontSize="26" Foreground="#1E1E1E" HorizontalAlignment="Center" Margin="0,16,0,4"/>

                <!-- 手机号(可多个, code-behind 填充) -->
                <StackPanel x:Name="PhoneList" HorizontalAlignment="Center" Spacing="4"/>

                <!-- 语音 / 视频 / 搜索 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="26" Margin="0,22,0,8">
                    <StackPanel Spacing="7">
                        <Button Classes="act">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#333" Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <TextBlock Text="语音" FontSize="12.5" Foreground="#444" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Spacing="7">
                        <Button Classes="act">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#333" Data="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <TextBlock Text="视频" FontSize="12.5" Foreground="#444" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Spacing="7">
                        <Button Classes="act">
                            <Path Width="18" Height="18" Stroke="#333" StrokeThickness="1.8" Fill="Transparent"
                                  Data="M7,2 A5,5 0 1 1 7,12 A5,5 0 1 1 7,2 Z M10.5,10.5 L15,15"/>
                        </Button>
                        <TextBlock Text="搜索" FontSize="12.5" Foreground="#444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 状态(签名) -->
                <StackPanel Margin="22,10,22,0">
                    <TextBlock Text="状态" FontSize="13" Foreground="#8A8A8A"/>
                    <TextBlock x:Name="StatusText" Text="" FontSize="14" Foreground="#1E1E1E" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Classes="sep" Margin="0,14,0,6"/>

                <!-- 影音内容、链接和文档 -->
                <Button Classes="opt">
                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch" MinWidth="360">
                        <Viewbox Grid.Column="0" Width="22" Height="22" Margin="0,0,18,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M22 16V4c0-1.1-.9-2-2-2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2zm-11-4l2.03 2.71L16 11l4 5H8l3-4zM2 6v14c0 1.1.9 2 2 2h14v-2H4V6H2z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="影音内容、链接和文档" FontSize="14" Foreground="#1E1E1E" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MediaCount" Grid.Column="2" Text="0" FontSize="13" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 媒体缩略图条(code-behind 填充) -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="22,2,22,6">
                    <StackPanel x:Name="MediaStrip" Orientation="Horizontal" Spacing="8"/>
                </ScrollViewer>

                <Border Classes="sep"/>

                <!-- 选项行 -->
                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="通知设置" FontSize="14" Foreground="#1E1E1E" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="限时消息" FontSize="14" Foreground="#1E1E1E"/>
                            <TextBlock Text="已关闭" FontSize="12.5" Foreground="#8A8A8A"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#555" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="加密" FontSize="14" Foreground="#1E1E1E"/>
                            <TextBlock Text="消息都是进行端到端加密，点击验证。" FontSize="12.5" Foreground="#8A8A8A"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Classes="sep"/>

                <!-- 共同群组(占位示例) -->
                <TextBlock x:Name="GroupCount" Text="1个共同群组" FontSize="13" Foreground="#8A8A8A" Margin="22,8,22,4"/>
                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#F0F2F5">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#777" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="水果批发" FontSize="14" Foreground="#1E1E1E"/>
                            <TextBlock Text="1111、..." FontSize="12.5" Foreground="#8A8A8A"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Border Classes="sep"/>

                <!-- 危险操作区(红色) -->
                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#C62828" Data="M7 11v2h10v-2H7zm5-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="清空聊天" FontSize="14" Foreground="#C62828" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#C62828" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="BlockText" Text="封锁" FontSize="14" Foreground="#C62828" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#C62828" Data="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="ReportText" Text="举报" FontSize="14" Foreground="#C62828" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="opt">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#C62828" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="删除聊天" FontSize="14" Foreground="#C62828" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
