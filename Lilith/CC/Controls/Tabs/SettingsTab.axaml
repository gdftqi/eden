<cc:BaseTab xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:cc="using:CC"
             x:Class="CC.SettingsTab">
    <!-- 骨架同 ChatTab: 左 280 列表列 + 右操作区; 内容后期填 -->
    <Grid ColumnDefinitions="280,*">
        <!-- TODO: 设置列表 -->
        <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"/>
        <!-- TODO: 设置操作界面 -->
        <Border Grid.Column="1" Background="#ECE5DD">
            <TextBlock Text="设置" FontSize="15" Foreground="#8A8A8A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</cc:BaseTab>
