<cc:BaseTab xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:cc="using:CC"
            x:Class="CC.SettingsTab">
    <!-- 骨架同 ChatTab: 左 280 列表列 + 右操作区 -->
    <Grid ColumnDefinitions="280,*">
        <cc:SettingsListPanel x:Name="ListPanel" Grid.Column="0"/>

        <Border Grid.Column="1">
            <Grid>
                <cc:SettingInfo x:Name="InfoView" IsVisible="False"/>
                <cc:SettingSecurity x:Name="SecurityView" IsVisible="False"/>
                <Border x:Name="EmptyState" Background="#EFEAE2">
                    <TextBlock Text="设置" FontSize="15" Foreground="#8A8A8A"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</cc:BaseTab>
