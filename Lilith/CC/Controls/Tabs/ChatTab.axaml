<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:CC"
             x:Class="CC.ChatTab">
    <Grid ColumnDefinitions="280,*">
        <!-- 会话列表 -->
        <cc:ChatListPanel x:Name="ChatPanel" Grid.Column="0"/>
        <!-- 聊天窗 / 未选会话时的空状态 -->
        <Border Grid.Column="1">
            <Grid>
                <cc:ChatWindow x:Name="ChatView" IsVisible="False"/>
                <Border x:Name="EmptyState" IsVisible="True" Background="#ECE5DD">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Margin="40">
                        <TextBlock Text="&#x201C;Look on my Works, ye Mighty, and despair!&#x201D;" FontFamily="Georgia" FontSize="30" FontStyle="Italic" FontWeight="SemiBold" Foreground="#4B4B4B" TextAlignment="Center" TextWrapping="Wrap" LineHeight="44"/>
                        <Border Height="1" Width="120" Background="#C9C9C9" Margin="0,22,0,14"/>
                        <TextBlock Text="— Ozymandias · Percy Bysshe Shelley, 1818" FontFamily="Georgia" FontSize="14" FontStyle="Italic" Foreground="#8A8A8A" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
