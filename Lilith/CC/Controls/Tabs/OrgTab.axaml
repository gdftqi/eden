<cc:BaseTab xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:CC"
             x:Class="CC.OrgTab">
    <Grid ColumnDefinitions="280,*">
        <!-- 部门列表 -->
        <cc:OrgListPanel x:Name="OrgPanel" Grid.Column="0"/>
        <!-- 群聊窗 / 未选部门时的空状态 (结构与 ChatTab 一致, 用 MultiChatWindow) -->
        <Border Grid.Column="1">
            <Grid>
                <cc:MultiChatWindow x:Name="ChatView" IsVisible="False"/>
                <cc:OrgEditPanel x:Name="OrgEditView" IsVisible="False"/>
                <cc:OrgMemberEditPanel x:Name="MemberEditView" IsVisible="False"/>
                <cc:OrgDetailPanel x:Name="OrgDetailView" IsVisible="False"/>
                <cc:ChatSearchPanel x:Name="SearchView" IsVisible="False"/>
                <Border x:Name="EmptyState" IsVisible="True" Background="#ECE5DD">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Margin="40">
                        <TextBlock Text="&#x201C;Let them hate, so long as they fear.&#x201D;" FontFamily="Georgia" FontSize="30" FontStyle="Italic" FontWeight="SemiBold" Foreground="#4B4B4B" TextAlignment="Center" TextWrapping="Wrap" LineHeight="44"/>
                        <Border Height="1" Width="120" Background="#C9C9C9" Margin="0,22,0,14"/>
                        <TextBlock Text="— Oderint dum metuant · Caligula" FontFamily="Georgia" FontSize="14" FontStyle="Italic" Foreground="#8A8A8A" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</cc:BaseTab>
