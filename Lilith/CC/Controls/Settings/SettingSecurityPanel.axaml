<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.SettingSecurity">
    <Grid Background="#F9FAFB" RowDefinitions="56,*,64">
        <Grid.Styles>
            <Style Selector="TextBlock.label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#5F6368"/>
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>

            <Style Selector="TextBox.fld">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#EBEEF2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBox.fld /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="#DDE1E7"/>
            </Style>
            <Style Selector="TextBox.fld:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#43A047"/>
            </Style>
            <Style Selector="TextBox.fld:focus-within /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#43A047"/>
            </Style>
            <Style Selector="TextBox.fld:focus-within">
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style Selector="Button.primary">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="88"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#43A047"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#4CAF50"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </Grid.Styles>

        <Border Grid.Row="0" Background="#F5F6F7" BorderBrush="#E4E7EB" BorderThickness="0,0,0,1" Padding="24,0">
            <TextBlock Text="隐私安全" FontSize="16" FontWeight="SemiBold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="360" HorizontalAlignment="Center" Margin="0,28,0,32">

                <TextBlock Text="修改密码" FontSize="15" FontWeight="SemiBold" Foreground="#1E1E1E"/>

                <TextBlock Classes="label" Text="当前密码"/>
                <TextBox x:Name="OldBox" Classes="fld" PasswordChar="●" MaxLength="16"/>

                <TextBlock Classes="label" Text="新密码"/>
                <TextBox x:Name="NewBox" Classes="fld" PasswordChar="●" MaxLength="16"/>

                <TextBlock Classes="label" Text="确认新密码"/>
                <TextBox x:Name="ConfirmBox" Classes="fld" PasswordChar="●" MaxLength="16"/>

                <TextBlock Text="8 到 16 位. 修改成功后需要重新登录."
                           FontSize="12" Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E4E7EB" BorderThickness="0,1,0,0" Padding="24,0">
            <Button Classes="primary" Click="Save_Click" Content="保存"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
