<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.SettingInfo">
    <Grid Background="#F9FAFB" RowDefinitions="56,*,64">
        <Grid.Styles>
            <!-- 头像 hover 时底部浮出的遮罩 -->
            <Style Selector="Panel.avatar Border#AvatarMask">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="Panel.avatar:pointerover Border#AvatarMask">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="Border#AvatarMask">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="TextBox.fld">
                <Setter Property="Width" Value="320"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#EBEEF2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBox.fld /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="#DDE1E7"/>
            </Style>
            <Style Selector="TextBox.fld:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#43A047"/>
            </Style>
            <Style Selector="TextBox.fld:focus-within /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#43A047"/>
            </Style>
            <Style Selector="TextBox.fld:focus-within">
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style Selector="Button.primary">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="88"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#43A047"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#4CAF50"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </Grid.Styles>

        <Border Grid.Row="0" Background="#F5F6F7" BorderBrush="#E4E7EB" BorderThickness="0,0,0,1" Padding="24,0">
            <TextBlock Text="个人信息" FontSize="16" FontWeight="SemiBold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="480" HorizontalAlignment="Center" Margin="0,28,0,32">

                <!-- 头像: 鼠标移上去底部浮出遮罩 + 相机, 点了换图 -->
                <Panel Classes="avatar" Width="128" Height="128" HorizontalAlignment="Center"
                       Background="Transparent" Cursor="Hand"
                       PointerPressed="PickAvatar_PointerPressed">
                    <Border CornerRadius="64" ClipToBounds="True" Background="#E4E7EB">
                        <Panel>
                            <Image x:Name="AvatarImage" Stretch="UniformToFill"/>

                            <Border x:Name="AvatarMask" Height="36" VerticalAlignment="Bottom" Background="#73000000">
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8.2c-1.77 0-3.2 1.43-3.2 3.2s1.43 3.2 3.2 3.2 3.2-1.43 3.2-3.2-1.43-3.2-3.2-3.2z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Panel>
                    </Border>
                </Panel>

                <TextBox x:Name="NickBox" Classes="fld" Margin="0,20,0,0" MaxLength="16" PlaceholderText="昵称"/>

                <!-- 用户名不可改, 只作展示 -->
                <TextBlock x:Name="UserNameText" FontSize="13" Foreground="#8A9099"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E4E7EB" BorderThickness="0,1,0,0" Padding="24,0">
            <Button Classes="primary" Click="Save_Click" Content="保存"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
