<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="CC.SettingsListPanel">
    <!-- 版式与 ChatListPanel 一致: 标题 48 / 搜索栏 / 列表 -->
    <Grid Background="White" RowDefinitions="48,Auto,*">
        <Grid.Styles>
            <!-- 设置项一行. 尺寸与其它列表项对齐(高 54 / 内边距 14 / 图标圆 38) -->
            <Style Selector="Border.row">
                <Setter Property="Height" Value="54"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Border.row:pointerover">
                <Setter Property="Background" Value="#F2F3F5"/>
            </Style>
            <Style Selector="Border.row.selected">
                <Setter Property="Background" Value="#F0F2F5"/>
            </Style>
            <Style Selector="Border.row.selected:pointerover">
                <Setter Property="Background" Value="#E9EDEF"/>
            </Style>
        </Grid.Styles>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="14,0,8,0">
            <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
        </Grid>

        <!-- 搜索栏: 与 ChatListPanel 同款 -->
        <Border Classes="search" Grid.Row="1" Height="36" Margin="12,2,12,8">
            <Border.Styles>
                <Style Selector="Border.search">
                    <Setter Property="Background" Value="#F0F2F5"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="CornerRadius" Value="18"/>
                </Style>
                <Style Selector="Border.search:focus-within">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00A884"/>
                </Style>
                <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0" Width="16" Height="16" Margin="11,0,8,0" VerticalAlignment="Center"
                      Stroke="#888" StrokeThickness="1.6" Fill="Transparent"
                      Data="M7,2 A5,5 0 1 1 7,12 A5,5 0 1 1 7,2 Z M10.5,10.5 L15,15"/>
                <TextBox x:Name="SearchBox" Classes="search" Grid.Column="1" PlaceholderText="搜索设置"
                         Background="Transparent" BorderThickness="0" FontSize="13"
                         VerticalContentAlignment="Center" Padding="0,0,4,0"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="2" Click="ClearSearch_Click" Width="26" Height="26" Padding="0"
                        Background="Transparent" CornerRadius="13" Margin="0,0,5,0" VerticalAlignment="Center"
                        IsVisible="{Binding #SearchBox.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#15000000"/>
                        </Style>
                    </Button.Styles>
                    <Path Width="11" Height="11" Stroke="#888" StrokeThickness="1.5" StrokeLineCap="Round"
                          Data="M1,1 L10,10 M10,1 L1,10"/>
                </Button>
            </Grid>
        </Border>

        <!-- 设置项 -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="InfoRow" Classes="row" PointerPressed="InfoRow_PointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#E4E7EB">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#5F6368" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="个人信息" FontSize="14" Foreground="#1E1E1E" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SecurityRow" Classes="row" PointerPressed="SecurityRow_PointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#E4E7EB">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#5F6368" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="隐私安全" FontSize="14" Foreground="#1E1E1E" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
