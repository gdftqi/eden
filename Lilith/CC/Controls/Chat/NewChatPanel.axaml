<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="CC.NewChatPanel">
    <Grid Background="White" RowDefinitions="48,Auto,*">
        <Grid.Styles>
            <Style Selector="Border.action">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Border.action:pointerover">
                <Setter Property="Background" Value="#F5F6F6"/>
            </Style>
            <Style Selector="Border.contact">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Border.contact:pointerover">
                <Setter Property="Background" Value="#F5F6F6"/>
            </Style>
        </Grid.Styles>

        <!-- 顶栏: 返回 + 新聊天 -->
        <Grid Grid.Row="0" Margin="4,0,8,0" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Click="Back_Click" Width="40" Height="40" Padding="0"
                    Background="Transparent" CornerRadius="20"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#11000000"/>
                    </Style>
                </Button.Styles>
                <Path Width="14" Height="14" Stroke="#111B21" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="M10,2 L4,8 L10,14"/>
            </Button>
            <TextBlock Grid.Column="1" Text="新聊天" FontSize="18" FontWeight="SemiBold"
                       Foreground="#111B21" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <!-- 搜索 -->
        <Border Classes="search" Grid.Row="1" Height="36" Margin="12,2,12,10">
            <Border.Styles>
                <Style Selector="Border.search">
                    <Setter Property="Background" Value="#F0F2F5"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="CornerRadius" Value="18"/>
                </Style>
                <Style Selector="Border.search:focus-within">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00A884"/>
                </Style>
                <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0" Width="16" Height="16" Margin="11,0,8,0" VerticalAlignment="Center"
                      Stroke="#888" StrokeThickness="1.6" Fill="Transparent"
                      Data="M7,2 A5,5 0 1 1 7,12 A5,5 0 1 1 7,2 Z M10.5,10.5 L15,15"/>
                <TextBox x:Name="SearchBox" Classes="search" Grid.Column="1"
                         PlaceholderText="搜索姓名或账号"
                         Background="Transparent" BorderThickness="0" FontSize="13"
                         VerticalContentAlignment="Center" Padding="0,0,4,0"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="2" Click="ClearSearch_Click" Width="26" Height="26" Padding="0"
                        Background="Transparent" CornerRadius="13" Margin="0,0,5,0" VerticalAlignment="Center"
                        IsVisible="{Binding #SearchBox.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#15000000"/>
                        </Style>
                    </Button.Styles>
                    <Path Width="11" Height="11" Stroke="#888" StrokeThickness="1.5" StrokeLineCap="Round"
                          Data="M1,1 L10,10 M10,1 L1,10"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 快捷操作 -->
                <Border Classes="action" PointerPressed="NewGroup_PointerPressed">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Background="#00A884" Margin="0,0,14,0">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" Text="新建群组" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#111B21" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="action" PointerPressed="AddContact_PointerPressed">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Background="#00A884" Margin="0,0,14,0">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" Text="添加联系人" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#111B21" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="联系人" FontSize="13" FontWeight="SemiBold" Foreground="#667781"
                           Margin="16,14,16,6"/>

                <StackPanel x:Name="ContactList"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
