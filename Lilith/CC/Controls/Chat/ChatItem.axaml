<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ChatItem"
             x:Name="Root">
    <Border x:Name="Body" Classes="item" Height="54" Padding="14,0" Focusable="True" FocusAdorner="{x:Null}">
        <Border.Styles>
            <Style Selector="Border.item">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <!-- hover 样式 -->
            <Style Selector="Border.item:pointerover">
                <Setter Property="Background" Value="#F5F6F6"/>
            </Style>
            <Style Selector="Border.item.selected">
                <Setter Property="Background" Value="#F0F2F5"/>
            </Style>
            <Style Selector="Border.item.selected:pointerover">
                <Setter Property="Background" Value="#E9EDEF"/>
            </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <!-- 头像 -->
            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" ClipToBounds="True" Margin="0,0,12,0">
                <Image Source="{Binding #Root.Avatar}" Stretch="UniformToFill"/>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <!-- 昵称 -->
                    <TextBlock Grid.Column="0" Text="{Binding #Root.Nickname}" FontSize="14" FontWeight="SemiBold" Foreground="#111B21" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- 最后一条消息的时间 -->
                    <TextBlock Grid.Column="1" Text="{Binding #Root.Time}" FontSize="11" Foreground="#667781" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <!-- 最后一条消息 -->
                    <TextBlock Grid.Column="0" Text="{Binding #Root.LastMessage}" FontSize="12.5" Foreground="#667781" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- 未读 -->
                    <Border Grid.Column="1" x:Name="Badge" Background="#25D366" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="False">
                        <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
