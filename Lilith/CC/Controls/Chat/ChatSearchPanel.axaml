<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="CC.ChatSearchPanel">
    <!-- 搜索消息: 返回 + 标题 / 日期入口 + 搜索框 / 空态提示或结果 -->
    <Grid Background="#F9FAFB" RowDefinitions="56,Auto,*">

        <!-- 头部 -->
        <Border Grid.Row="0" Padding="10,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Back_Click" Width="34" Height="34" Padding="0" CornerRadius="17" Background="Transparent">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#11000000"/>
                        </Style>
                    </Button.Styles>
                    <Path Width="18" Height="18" Stroke="#3C4043" StrokeThickness="1.8" Fill="Transparent"
                          StrokeLineCap="Round" StrokeJoin="Round" Data="M11,3 L5,9 L11,15 M5,9 L17,9"/>
                </Button>
                <TextBlock Text="搜索消息" FontSize="16" Foreground="#1E1E1E" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 日期入口 + 搜索框 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="14,4,20,14">
            <!-- 按日期查找 -->
            <Button Grid.Column="0" Click="ByDate_Click" Width="40" Height="40" Padding="0"
                    CornerRadius="20" Background="Transparent" ToolTip.Tip="按日期查找">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#11000000"/>
                    </Style>
                </Button.Styles>
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#5F6368" Data="M17 12c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm1.65 7.35L16.5 17.2V14h1v2.79l1.85 1.85-.7.71zM19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h6.11c-.59-.57-1.07-1.25-1.42-2H5V8h14v2.02c.71.06 1.39.24 2 .52V5c0-1.1-.9-2-2-2z"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 搜索框: 样式沿用列表页的搜索栏 -->
            <Border Grid.Column="1" Classes="search" Height="44" Margin="6,0,0,0">
                <Border.Styles>
                    <Style Selector="Border.search">
                        <Setter Property="Background" Value="#F0F2F5"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="22"/>
                    </Style>
                    <Style Selector="Border.search:focus-within">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#00A884"/>
                    </Style>
                    <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="14,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#5F6368" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBox x:Name="SearchBox" Classes="search" Grid.Column="1" PlaceholderText="搜索"
                             Background="Transparent" BorderThickness="0" FontSize="14"
                             VerticalContentAlignment="Center" Padding="0,0,4,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button Grid.Column="2" Click="ClearSearch_Click" Width="30" Height="30" Padding="0"
                            Background="Transparent" CornerRadius="15" Margin="0,0,8,0" VerticalAlignment="Center"
                            IsVisible="{Binding #SearchBox.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#15000000"/>
                            </Style>
                        </Button.Styles>
                        <Path Width="11" Height="11" Stroke="#888" StrokeThickness="1.5" StrokeLineCap="Round"
                              Data="M1,1 L10,10 M10,1 L1,10"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 空态 / 结果 -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="HintText" FontSize="14" Foreground="#5E6B7E"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,60,24,0"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <ScrollViewer x:Name="ResultScroll" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ResultList"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
