<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="CC.MessageBubble"
             x:Name="Root"
             Margin="0,1.5">
    <UserControl.Styles>
        <!-- 发送中的转圈. 两个要点:
             1. RenderTransform 本身没有 animator, 必须先把它设成 RotateTransform, 再动画 Angle
             2. 选择器带 [IsVisible=True]: 不显示时让样式失配, 动画随之停掉,
                否则一屏几十个气泡会各自空转一个动画 -->
        <Style Selector="Path#Spinner[IsVisible=True]">
            <Setter Property="RenderTransform">
                <RotateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <!-- 外框 -->
    <Border x:Name="Bubble" CornerRadius="8" Padding="9,6,9,5" MaxWidth="460" Background="White" BoxShadow="0 1 1.5 0 #18000000">
        <StackPanel>
            <!-- 文本 -->
            <SelectableTextBlock x:Name="TextBlk" TextWrapping="Wrap" FontSize="14" Foreground="#111B21" SelectionBrush="#80128C7E" IsVisible="{Binding #Root.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            <!-- 其它类型 -->
            <ContentPresenter Content="{Binding #Root.Body}" IsVisible="{Binding #Root.Body, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="8,1,0,0">
                <!-- 时间 -->
                <TextBlock Text="{Binding #Root.Time}" FontSize="11" Foreground="#8696A0" VerticalAlignment="Center"/>
                <!-- 发送中 -->
                <Path x:Name="Spinner" Width="10" Height="10" Stroke="#8696A0" StrokeThickness="1.4" StrokeLineCap="Round"
                      Data="M5,0.7 A4.3,4.3 0 1 1 0.7,5" RenderTransformOrigin="50%,50%"
                      VerticalAlignment="Center" IsVisible="False"/>
                <!-- 回执 -->
                <Path x:Name="Ticks" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" IsVisible="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
