<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:CC"
             x:Class="CC.OrgEditPanel">
    <!-- 创建部门.版式刻意与 OrgDetailPanel 一致:
         同样的头部 / 480 居中列 / 大头像 / Border.row 行式成员列表,
         只是名称从只读文字换成输入框, 底部多一条按钮栏. -->
    <Grid Background="#F9FAFB" RowDefinitions="56,*,64">
        <Grid.Styles>
            <!-- 列表行: 与 OrgDetailPanel 同一套(高度/内边距/hover 都一致) -->
            <Style Selector="Border.row">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Border.row:pointerover">
                <Setter Property="Background" Value="#F5F6F7"/>
            </Style>
            <Style Selector="TextBlock.rowTitle">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#1E1E1E"/>
            </Style>

            <!-- 部门名输入: 居中, 呼应详情页那个居中的大标题 -->
            <Style Selector="TextBox.name">
                <Setter Property="Width" Value="320"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#EBEEF2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <!-- 边框三态: 常态浅灰(始终看得见轮廓) / 悬停变绿 / 聚焦也是绿 -->
            <Style Selector="TextBox.name /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="#DDE1E7"/>
            </Style>
            <Style Selector="TextBox.name:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#43A047"/>
            </Style>
            <Style Selector="TextBox.name:focus-within /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#43A047"/>
            </Style>
            <Style Selector="TextBox.name:focus-within">
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style Selector="Button.primary">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="88"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#43A047"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#4CAF50"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Button.ghost">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="88"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="Foreground" Value="#5A5A5A"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#E4E7EB"/>
                <Setter Property="Foreground" Value="#1E1E1E"/>
            </Style>
        </Grid.Styles>

        <!-- 头部: 与详情页同款 -->
        <Border Grid.Row="0" Background="#F5F6F7" BorderBrush="#E4E7EB" BorderThickness="0,0,0,1" Padding="24,0">
            <TextBlock Text="创建部门" FontSize="16" FontWeight="SemiBold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="480" HorizontalAlignment="Center" Margin="0,28,0,32">

                <!-- 大头像: 与详情页同尺寸同配色 -->
                <Border Width="128" Height="128" CornerRadius="64" Background="#DCE9FB" HorizontalAlignment="Center">
                    <Viewbox Width="60" Height="60">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#1A73E8" Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- 部门名称: 详情页这个位置是居中的大标题, 这里换成居中输入框 -->
                <TextBox x:Name="NameBox" Classes="name" Margin="0,20,0,0"
                         MaxLength="32" PlaceholderText="部门名称"/>

                <!-- 校验提示: 平时不占位 -->
                <TextBlock x:Name="ErrorTip" Text="" FontSize="12" Foreground="#E53935"
                           HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="False"/>

                <Border Height="1" Background="#E8EAED" Margin="0,24,0,0"/>

                <!-- 成员区: 结构与详情页一致(标题 + 添加成员行 + 成员行) -->
                <TextBlock x:Name="MemberHeader" FontSize="13" Foreground="#8A9099" Margin="14,18,0,6"/>

                <!-- 添加成员(绿圆), 点它展开/收起联系人勾选列表 -->
                <Border Classes="row" PointerPressed="TogglePicker_PointerPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#43A047" Margin="0,0,14,0">
                            <Viewbox Width="21" Height="21">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" Classes="rowTitle" Text="添加成员" VerticalAlignment="Center"/>
                        <!-- 右向箭头: 提示"点开会从右边推出一个面板", 不是就地展开 -->
                        <Path Grid.Column="2" Width="14" Height="14"
                              Stroke="#999" StrokeThickness="1.8" Fill="Transparent"
                              StrokeLineCap="Round" StrokeJoin="Round" Data="M5,3 L9,7 L5,11"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 已选成员列在这里; 选人的列表不在这一列, 见下面的右侧抽屉 -->

                <!-- 已选成员(行式, 与详情页一致) -->
                <StackPanel x:Name="MemberList"/>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E4E7EB" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="ghost"   Click="Cancel_Click" Content="取消"/>
                <Button Classes="primary" Click="Save_Click"   Content="确定"/>
            </StackPanel>
        </Border>

        <!-- 选人抽屉: 从右滑入, 盖在整个面板上.
             跨全部行, 关闭时整块平移到右边界之外; 实现见 ContactPickerDrawer -->
        <cc:ContactPickerDrawer x:Name="Picker" Grid.Row="0" Grid.RowSpan="3"/>

    </Grid>
</UserControl>
