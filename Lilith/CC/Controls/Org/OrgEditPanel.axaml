<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:CC"
             x:Class="CC.OrgEditPanel">
    <Grid Background="#FFFFFF" RowDefinitions="56,*,72">
        <Grid.Styles>
            <Style Selector="Border.row">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="MinHeight" Value="64"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="#E9EDEF"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style Selector="Border.row:pointerover">
                <Setter Property="Background" Value="#F5F6F6"/>
                <Setter Property="BorderBrush" Value="#D1D7DB"/>
            </Style>
            <Style Selector="TextBlock.rowTitle">
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#111B21"/>
            </Style>
            <Style Selector="TextBlock.label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#54656F"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style Selector="TextBox.fld">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
            <Style Selector="TextBox.fld /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style Selector="TextBox.fld:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="#E9EDEF"/>
            </Style>
            <Style Selector="TextBox.fld:focus-within /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#00A884"/>
                <Setter Property="Background" Value="White"/>
            </Style>
            <Style Selector="TextBox.fld:focus-within">
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style Selector="TextBox.name">
                <Setter Property="Height" Value="48"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style Selector="TextBox.desc">
                <Setter Property="MinHeight" Value="88"/>
                <Setter Property="MaxHeight" Value="140"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Style>

            <Style Selector="Button.primary">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="108"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#008069"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#00A884"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Button.ghost">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="108"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="Foreground" Value="#54656F"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#E9EDEF"/>
                <Setter Property="Foreground" Value="#111B21"/>
            </Style>
        </Grid.Styles>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E9EDEF" BorderThickness="0,0,0,1" Padding="28,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="#E7F8F1" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#008069" Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="创建部门" FontSize="17" FontWeight="SemiBold" Foreground="#111B21" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Background="#F0F2F5">
            <Border MaxWidth="640" HorizontalAlignment="Stretch" Margin="28,24,28,28"
                    Background="White" CornerRadius="12" Padding="32,28"
                    BoxShadow="0 1 3 0 #14000000" BorderBrush="#E9EDEF" BorderThickness="1">
                <StackPanel>

                    <!-- 头像 -->
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,28">
                        <Panel Classes="avatar" Width="88" Height="88"
                               Background="Transparent" Cursor="Hand"
                               PointerPressed="PickAvatar_PointerPressed">
                            <Panel.Styles>
                                <Style Selector="Panel.avatar Border#AvatarMask">
                                    <Setter Property="Opacity" Value="0"/>
                                </Style>
                                <Style Selector="Panel.avatar:pointerover Border#AvatarMask">
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style Selector="Border#AvatarMask">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                            </Panel.Styles>

                            <Border CornerRadius="44" ClipToBounds="True" Background="#E7F8F1"
                                    BorderBrush="#C8EDE0" BorderThickness="1">
                                <Panel>
                                    <Viewbox x:Name="AvatarIcon" Width="40" Height="40">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#008069" Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Image x:Name="AvatarImage" Stretch="UniformToFill" IsVisible="False"/>
                                    <Border x:Name="AvatarMask" Height="28" VerticalAlignment="Bottom" Background="#99008069">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White" Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8.2c-1.77 0-3.2 1.43-3.2 3.2s1.43 3.2 3.2 3.2 3.2-1.43 3.2-3.2-1.43-3.2-3.2-3.2z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Panel>
                            </Border>
                        </Panel>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="部门头像" FontSize="14.5" FontWeight="SemiBold" Foreground="#111B21"/>
                            <TextBlock Text="点击上传，可选填" FontSize="12.5" Foreground="#667781"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 基本信息 -->
                    <TextBlock Text="基本信息" FontSize="12" FontWeight="SemiBold" Foreground="#8696A0"
                               Margin="0,0,0,14" LetterSpacing="0.4"/>

                    <TextBlock Classes="label" Text="部门名称"/>
                    <TextBox x:Name="NameBox" Classes="fld name" MaxLength="32" PlaceholderText="例如：技术部"/>

                    <TextBlock Classes="label" Text="部门描述" Margin="0,18,0,8"/>
                    <TextBox x:Name="DescBox" Classes="fld desc" MaxLength="200" TextWrapping="Wrap"
                             AcceptsReturn="True" PlaceholderText="选填，简要说明这个部门的职责"/>

                    <!-- 成员 -->
                    <Border Height="1" Background="#E9EDEF" Margin="0,28,0,22"/>
                    <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部门成员" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#8696A0" VerticalAlignment="Center" LetterSpacing="0.4"/>
                        <TextBlock x:Name="MemberHeader" Grid.Column="1" FontSize="12.5" Foreground="#667781"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Classes="row" PointerPressed="TogglePicker_PointerPressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#008069" Margin="0,0,14,0">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="rowTitle" Text="添加成员"/>
                                <TextBlock FontSize="12.5" Foreground="#667781" Text="从通讯录选择部门成员"/>
                            </StackPanel>
                            <Path Grid.Column="2" Width="14" Height="14" Stroke="#8696A0" StrokeThickness="1.8"
                                  Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M5,3 L9,7 L5,11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="MemberList" Margin="0,10,0,0" Spacing="4"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9EDEF" BorderThickness="0,1,0,0" Padding="28,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="ghost"   Click="Cancel_Click" Content="取消"/>
                <Button Classes="primary" Click="Save_Click"   Content="创建部门"/>
            </StackPanel>
        </Border>

        <cc:ContactPickerDrawer x:Name="Picker" Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
</UserControl>
