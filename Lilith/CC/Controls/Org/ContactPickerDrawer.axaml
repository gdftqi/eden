<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.ContactPickerDrawer"
             HorizontalAlignment="Right" Width="360"
             IsVisible="False" RenderTransform="translateX(360px)">
    <UserControl.Transitions>
        <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut"/>
        </Transitions>
    </UserControl.Transitions>

    <Border Background="White" BorderBrush="#E4E7EB" BorderThickness="1,0,0,0"
            BoxShadow="-4 0 16 0 #1A000000">
        <Grid RowDefinitions="52,Auto,*">
            <!-- 抽屉头: 标题 + 右上角关闭 -->
            <Border Grid.Row="0" Background="#F5F6F7" BorderBrush="#E4E7EB" BorderThickness="0,0,0,1" Padding="16,0,8,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" x:Name="TitleText" Text="选择联系人"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#1E1E1E" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="Close_Click" Width="32" Height="32" Padding="0"
                            CornerRadius="16" Background="Transparent" VerticalAlignment="Center"
                            ToolTip.Tip="关闭">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#11000000"/>
                            </Style>
                        </Button.Styles>
                        <Path Width="12" Height="12" Stroke="#5F6368" StrokeThickness="1.6"
                              StrokeLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 搜索框 -->
            <Border Grid.Row="1" Classes="psearch" Height="34" Margin="12,10,12,6">
                <Border.Styles>
                    <Style Selector="Border.psearch">
                        <Setter Property="Background" Value="#F0F2F5"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="17"/>
                    </Style>
                    <Style Selector="Border.psearch:focus-within">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#00A884"/>
                    </Style>
                    <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*">
                    <Viewbox Grid.Column="0" Width="15" Height="15" Margin="11,0,7,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#8A9099" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBox x:Name="PickerSearch" Classes="plain" Grid.Column="1"
                             PlaceholderText="搜索联系人" Background="Transparent" BorderThickness="0"
                             FontSize="13" VerticalContentAlignment="Center" Padding="0,0,10,0"
                             TextChanged="PickerSearch_TextChanged"/>
                </Grid>
            </Border>

            <!-- 左侧索引条 + 列表 -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                <!-- 索引条: 只列出真的有人的字母, 点一下跳到那一组 -->
                <StackPanel Grid.Column="0" x:Name="IndexBar" Width="26" Margin="2,0,0,8"
                            VerticalAlignment="Center"/>
                <ScrollViewer Grid.Column="1" x:Name="PickerScroll" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PickerList" Margin="0,0,0,8"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
