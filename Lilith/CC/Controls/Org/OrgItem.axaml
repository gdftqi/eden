<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.OrgItem"
             x:Name="Root">
    <!-- 尺寸与"创建部门/创建成员"那两个按钮对齐:
         高 38+8*2=54, 文字左边距 14+38+12=64 -->
    <Border x:Name="Body" Classes="item" Height="54" Padding="14,0" Focusable="True" FocusAdorner="{x:Null}">
        <Border.Styles>
            <Style Selector="Border.item">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="Border.item:pointerover">
                <Setter Property="Background" Value="#F2F3F5"/>
            </Style>
            <Style Selector="Border.item.selected">
                <Setter Property="Background" Value="#D9EDDA"/>
            </Style>
            <Style Selector="Border.item.selected:pointerover">
                <Setter Property="Background" Value="#CFE8D1"/>
            </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <Panel Grid.Column="0" Width="38" Height="38" Margin="0,0,12,0">
                <Border x:Name="IconAvatar" CornerRadius="19" Background="#E4E7EB">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#5F6368" Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border x:Name="PhotoAvatar" CornerRadius="19" ClipToBounds="True" IsVisible="False">
                    <Image x:Name="PhotoImage" Stretch="UniformToFill"/>
                </Border>
            </Panel>

            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <!-- 部门名 -->
                    <TextBlock Grid.Column="0" Text="{Binding #Root.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E1E1E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- 最后一条消息的时间 -->
                    <TextBlock Grid.Column="1" Text="{Binding #Root.Time}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <!-- 最后一条消息 -->
                    <TextBlock Grid.Column="0" Text="{Binding #Root.LastMessage}" FontSize="12.5" Foreground="#8A9099" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- 未读 -->
                    <Border Grid.Column="1" x:Name="Badge" Background="#F5333F" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="False">
                        <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
