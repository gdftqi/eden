<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.OrgItem"
             x:Name="Root">
    <Border x:Name="Body" Classes="item" Height="56" Padding="14,0" Focusable="True" FocusAdorner="{x:Null}">
        <Border.Styles>
            <Style Selector="Border.item">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <!-- hover 样式 -->
            <Style Selector="Border.item:pointerover">
                <Setter Property="Background" Value="#F2F3F5"/>
            </Style>
            <!-- 展开时右侧箭头转 90°(指下) -->
            <Style Selector="Border.item Path.chev">
                <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            </Style>
            <Style Selector="Border.item.expanded Path.chev">
                <Setter Property="RenderTransform" Value="rotate(90deg)"/>
            </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- 部门图标 -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#F0F2F5" Margin="0,0,12,0">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#777" Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <!-- 部门名 -->
            <TextBlock Grid.Column="1" Text="{Binding #Root.DeptName}" FontSize="14.5" Foreground="#1E1E1E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <!-- 展开箭头 -->
            <Path Grid.Column="2" Classes="chev" Width="16" Height="16" Stroke="#999" StrokeThickness="1.8" Fill="Transparent"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="M6,3 L11,8 L6,13"
                  RenderTransformOrigin="50%,50%" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
