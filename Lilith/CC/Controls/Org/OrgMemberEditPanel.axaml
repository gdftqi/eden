<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CC.OrgMemberEditPanel">
    <!-- 创建成员: 版式对齐 OrgEditPanel -->
    <Grid Background="#FFFFFF" RowDefinitions="56,*,72">
        <Grid.Styles>
            <Style Selector="TextBlock.label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#54656F"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style Selector="TextBox.field">
                <Setter Property="Height" Value="48"/>
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#111B21"/>
            </Style>
            <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="#E9EDEF"/>
            </Style>
            <Style Selector="TextBox.field:focus-within /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#00A884"/>
                <Setter Property="Background" Value="White"/>
            </Style>
            <Style Selector="TextBox.field:focus-within">
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style Selector="Border.pick">
                <Setter Property="Height" Value="48"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Border.pick:pointerover">
                <Setter Property="Background" Value="#E9EDEF"/>
                <Setter Property="BorderBrush" Value="#00A884"/>
            </Style>

            <Style Selector="Button.primary">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="108"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#008069"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#00A884"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Button.ghost">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="108"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#F0F2F5"/>
                <Setter Property="Foreground" Value="#54656F"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#E9EDEF"/>
                <Setter Property="Foreground" Value="#111B21"/>
            </Style>
        </Grid.Styles>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E9EDEF" BorderThickness="0,0,0,1" Padding="28,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="#E7F8F1" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#008069" Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="创建成员" FontSize="17" FontWeight="SemiBold" Foreground="#111B21" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Background="#F0F2F5">
            <Border MaxWidth="640" HorizontalAlignment="Stretch" Margin="28,24,28,28"
                    Background="White" CornerRadius="12" Padding="32,28"
                    BoxShadow="0 1 3 0 #14000000" BorderBrush="#E9EDEF" BorderThickness="1">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,28">
                        <Border Width="88" Height="88" CornerRadius="44" Background="#E7F8F1"
                                BorderBrush="#C8EDE0" BorderThickness="1">
                            <Viewbox Width="42" Height="42">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#008069" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="新成员资料" FontSize="14.5" FontWeight="SemiBold" Foreground="#111B21"/>
                            <TextBlock Text="创建后可在通讯录与组织架构中找到" FontSize="12.5" Foreground="#667781"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="账号信息" FontSize="12" FontWeight="SemiBold" Foreground="#8696A0"
                               Margin="0,0,0,14" LetterSpacing="0.4"/>

                    <TextBlock Classes="label" Text="用户名"/>
                    <TextBox x:Name="NameBox" Classes="field" MaxLength="32" PlaceholderText="登录用的用户名"/>

                    <TextBlock Classes="label" Text="初始密码" Margin="0,18,0,8"/>
                    <TextBox x:Name="PassBox" Classes="field" MaxLength="64" PasswordChar="●" PlaceholderText="至少 8 位"/>

                    <Border Height="1" Background="#E9EDEF" Margin="0,28,0,22"/>
                    <TextBlock Text="组织信息" FontSize="12" FontWeight="SemiBold" Foreground="#8696A0"
                               Margin="0,0,0,14" LetterSpacing="0.4"/>

                    <TextBlock Classes="label" Text="所属部门"/>
                    <Border x:Name="DeptPicker" Classes="pick" PointerPressed="OpenDeptPicker_PointerPressed">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" x:Name="DeptSummary" FontSize="14.5" Foreground="#111B21"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Path Grid.Column="1" Width="14" Height="14"
                                  Stroke="#8696A0" StrokeThickness="1.8" Fill="Transparent"
                                  StrokeLineCap="Round" StrokeJoin="Round" Data="M5,3 L9,7 L5,11"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Classes="label" Text="手机号" Margin="0,18,0,8"/>
                    <TextBox x:Name="PhoneBox" Classes="field" MaxLength="20" PlaceholderText="选填"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9EDEF" BorderThickness="0,1,0,0" Padding="28,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="ghost"   Click="Cancel_Click" Content="取消"/>
                <Button Classes="primary" Click="Save_Click"   Content="创建成员"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" x:Name="DeptDrawer"
                HorizontalAlignment="Right" Width="360"
                Background="White" BorderBrush="#E9EDEF" BorderThickness="1,0,0,0"
                BoxShadow="-4 0 16 0 #1A000000"
                IsVisible="False" RenderTransform="translateX(360px)">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="52,Auto,*">
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E9EDEF" BorderThickness="0,0,0,1" Padding="16,0,8,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="选择部门" FontSize="15" FontWeight="SemiBold" Foreground="#111B21" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="CloseDeptPicker_Click" Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" VerticalAlignment="Center"
                                ToolTip.Tip="关闭">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#F0F2F5"/>
                                </Style>
                            </Button.Styles>
                            <Path Width="12" Height="12" Stroke="#54656F" StrokeThickness="1.6" StrokeLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="dsearch" Height="36" Margin="12,10,12,8">
                    <Border.Styles>
                        <Style Selector="Border.dsearch">
                            <Setter Property="Background" Value="#F0F2F5"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                        <Style Selector="Border.dsearch:focus-within">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#00A884"/>
                        </Style>
                        <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="Auto,*">
                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="11,0,7,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#8696A0" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBox x:Name="DeptSearch" Classes="plain" Grid.Column="1" PlaceholderText="搜索部门"
                                 Background="Transparent" BorderThickness="0" FontSize="13"
                                 VerticalContentAlignment="Center" Padding="0,0,10,0" TextChanged="DeptSearch_TextChanged"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DeptList" Margin="0,0,0,8"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
