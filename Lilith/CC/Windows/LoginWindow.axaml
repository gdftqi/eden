<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="580"
        x:Class="CC.LoginWindow"
        Title="登录"
        Icon="/Resources/app.png"
        Width="920" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Border CornerRadius="12" ClipToBounds="True" BorderBrush="#D1D7DB" BorderThickness="1">
        <Grid ColumnDefinitions="1.05*,1*">
            <!-- 左侧品牌区: 纯色渐变, 无底纹 -->
            <Border Grid.Column="0" PointerPressed="TopBar_PointerPressed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="30%,0%" EndPoint="70%,100%">
                        <GradientStop Color="#008069" Offset="0"/>
                        <GradientStop Color="#00A884" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="48,0" Spacing="18">
                        <Border Width="112" Height="112" CornerRadius="56" Background="#14FFFFFF" HorizontalAlignment="Center">
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="32" Height="32">
                                    <Path Fill="White"
                                          Data="M16,2.2 C8.9,2.2 3.2,7.4 3.2,13.8 C3.2,16.7 4.4,19.3 6.4,21.2 L3.6,28.2 L11.2,25.4 C12.7,25.8 14.3,26.1 16,26.1 C23.1,26.1 28.8,20.9 28.8,13.8 C28.8,7.4 23.1,2.2 16,2.2 Z"/>
                                    <Ellipse Canvas.Left="9.2" Canvas.Top="11.6" Width="3.6" Height="3.6" Fill="#008069"/>
                                    <Ellipse Canvas.Left="14.2" Canvas.Top="11.6" Width="3.6" Height="3.6" Fill="#008069"/>
                                    <Ellipse Canvas.Left="19.2" Canvas.Top="11.6" Width="3.6" Height="3.6" Fill="#008069"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="CC" FontSize="42" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" LetterSpacing="2"/>
                        <TextBlock Text="简单、可靠、私密的即时通讯" FontSize="15" Foreground="#E8FFFB"
                                   HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.92"/>
                    </StackPanel>
                    <TextBlock Text="CC" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16"/>
                </Grid>
            </Border>

            <!-- 右侧表单 -->
            <Border Grid.Column="1" Background="#FFFFFF">
                <Grid>
                    <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="44" Height="40" Padding="0" CornerRadius="0" Background="Transparent" ZIndex="2">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#E81123"/>
                            </Style>
                            <Style Selector="Button:pointerover Path">
                                <Setter Property="Stroke" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <Path Width="12" Height="12" Stroke="#54656F" StrokeThickness="1.4" StrokeLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/>
                    </Button>

                    <StackPanel x:Name="LoginForm" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                Width="340" Margin="0,20">
                        <StackPanel.Styles>
                            <Style Selector="TextBox.fld">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Background" Value="#F0F2F5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="14.5"/>
                                <Setter Property="Foreground" Value="#111B21"/>
                            </Style>
                            <Style Selector="TextBox.fld /template/ Border#PART_BorderElement">
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="#F0F2F5"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                            <Style Selector="TextBox.fld:pointerover /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="#E9EDEF"/>
                            </Style>
                            <Style Selector="TextBox.fld:focus-within /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#00A884"/>
                            </Style>
                            <Style Selector="Button.login">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Background" Value="#008069"/>
                            </Style>
                            <Style Selector="Button.login:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#00A884"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <Style Selector="Button.login:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="#025C4C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <Style Selector="CheckBox.remember /template/ Border#NormalRectangle">
                                <Setter Property="BorderBrush" Value="#8696A0"/>
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                            <Style Selector="CheckBox.remember:checked /template/ Border#NormalRectangle">
                                <Setter Property="Background" Value="#008069"/>
                                <Setter Property="BorderBrush" Value="#008069"/>
                            </Style>
                        </StackPanel.Styles>

                        <TextBlock Text="登录到你的账号" FontSize="26" FontWeight="Bold" Foreground="#111B21"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="使用用户名和密码继续" FontSize="14" Foreground="#667781"
                                   Margin="0,0,0,32"/>

                        <StackPanel Spacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="用户名" FontSize="13" FontWeight="SemiBold" Foreground="#54656F"/>
                                <TextBox x:Name="txtUsername" Classes="fld" PlaceholderText="输入用户名"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold" Foreground="#54656F"/>
                                <TextBox x:Name="txtPassword" Classes="fld" PlaceholderText="输入密码" PasswordChar="●"/>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                                    <CheckBox Classes="remember" VerticalAlignment="Center" Padding="0"/>
                                    <TextBlock Text="记住密码" FontSize="13" Foreground="#54656F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrorText" Foreground="#EA4335" FontSize="13"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="180" TextAlignment="Right" IsVisible="False"/>
                            </Grid>

                            <Button Classes="login" Content="登录" Click="Login_Click" IsDefault="True" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" IsVisible="False">
                        <StackPanel.Styles>
                            <Style Selector="Ellipse.spinner">
                                <Style.Animations>
                                    <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </StackPanel.Styles>
                        <Ellipse Classes="spinner" Width="42" Height="42" Stroke="#008069" StrokeThickness="3.5"
                                 StrokeDashArray="28,12" StrokeLineCap="Round"
                                 RenderTransformOrigin="50%,50%" HorizontalAlignment="Center">
                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="正在连接..." Foreground="#54656F" FontSize="15" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
