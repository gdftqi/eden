<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:cc="using:CC"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CC.MainWindow"
        Title="cc"
        Icon="/Resources/app.ico"
        MinWidth="1000" MinHeight="580"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Border CornerRadius="8" ClipToBounds="True">
    <Grid>
        <!-- Main: 侧栏通高 (与 WhatsApp Web 一致) -->
        <Grid ColumnDefinitions="60,*">
            <!-- SideBar -->
            <Border Grid.Column="0" Background="#F0F2F5" BorderBrush="#E9EDEF" BorderThickness="0,0,1,0">
                <Grid>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="4">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Width" Value="44"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#E9EDEF"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Click="Chat_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="ChatIcon" Fill="#111B21" Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
                                <Ellipse x:Name="ChatDot" Canvas.Left="15" Canvas.Top="-1" Width="9" Height="9"
                                         Fill="#25D366" Stroke="#F0F2F5" StrokeThickness="1.5" IsVisible="False"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Click="Contacts_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="ContactsIcon" Fill="#54656F" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Click="Org_Click">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="OrgIcon" Fill="#54656F" Data="M22 11V3h-7v3H9V3H2v8h7V8h2v10h4v3h7v-8h-7v3h-2V8h2v3z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Spacing="10">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#E9EDEF"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Click="Settings_Click" Width="44" Height="44">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="SettingsIcon" Fill="#54656F" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                        <Image x:Name="Avatar" Stretch="UniformToFill"/>
                    </Border>
                </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="36,*">
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E9EDEF" BorderThickness="0,0,0,1" PointerPressed="TopBar_PointerPressed">
                    <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" Spacing="8">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="32" Height="32">
                                <Path Fill="#25D366"
                                      Data="M16,2.2 C8.9,2.2 3.2,7.4 3.2,13.8 C3.2,16.7 4.4,19.3 6.4,21.2 L3.6,28.2 L11.2,25.4 C12.7,25.8 14.3,26.1 16,26.1 C23.1,26.1 28.8,20.9 28.8,13.8 C28.8,7.4 23.1,2.2 16,2.2 Z"/>
                                <Ellipse Canvas.Left="9.2" Canvas.Top="11.6" Width="3.6" Height="3.6" Fill="White"/>
                                <Ellipse Canvas.Left="14.2" Canvas.Top="11.6" Width="3.6" Height="3.6" Fill="White"/>
                                <Ellipse Canvas.Left="19.2" Canvas.Top="11.6" Width="3.6" Height="3.6" Fill="White"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="CC" FontSize="13" FontWeight="SemiBold" Foreground="#111B21" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                                <Setter Property="Width" Value="40"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#F0F2F5"/>
                            </Style>
                            <Style Selector="Button.close:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#E81123"/>
                            </Style>
                            <Style Selector="Button.close:pointerover Path">
                                <Setter Property="Stroke" Value="White"/>
                            </Style>
                        </StackPanel.Styles>
                        <Button Click="Minimize_Click">
                            <Path Width="12" Height="12" Stroke="#54656F" StrokeThickness="1.2" Data="M0,6 H12"/>
                        </Button>
                        <Button Click="Maximize_Click">
                            <Path x:Name="MaxIcon" Width="12" Height="12" Stroke="#54656F" StrokeThickness="1.2" Fill="Transparent" Data="M1,1 H11 V11 H1 Z"/>
                        </Button>
                        <Button Click="Button_Click" Classes="close">
                            <Path Width="12" Height="12" Stroke="#54656F" StrokeThickness="1.2" StrokeLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/>
                        </Button>
                    </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <cc:ChatTab x:Name="TabChat"/>
                    <cc:ContactTab x:Name="TabContact" IsVisible="False"/>
                    <cc:OrgTab x:Name="TabOrg" IsVisible="False"/>
                    <cc:SettingsTab x:Name="TabSettings" IsVisible="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 窗体边缘 -->
        <Rectangle VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="6" Margin="6,0" Fill="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="Resize_PointerPressed"/>
        <Rectangle VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="6" Margin="6,0" Fill="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="0,6" Fill="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Margin="0,6" Fill="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="10" Fill="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Fill="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="10" Height="10" Fill="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="Resize_PointerPressed"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10" Fill="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="Resize_PointerPressed"/>

        <!-- 连接状态提示条: 左下角浮动, 白底黑字, 从左滑出(translateX -180 -> 0) -->
        <Border x:Name="ConnBanner" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="180" Height="38" Margin="0,0,0,14" Background="White" CornerRadius="19" BoxShadow="2 2 12 0 #28000000" IsHitTestVisible="False" RenderTransform="translateX(-180px)">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <!-- spinner 持续旋转 -->
                <Style Selector="Ellipse.spinner">
                    <Style.Animations>
                        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                            <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Grid Margin="14,0,12,0" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ConnText" Grid.Column="0" Text="连接断开" Foreground="#222222" FontSize="13" VerticalAlignment="Center"/>
                <!-- 断开: 红点 -->
                <Ellipse x:Name="ConnDot" Grid.Column="1" Width="9" Height="9" Fill="#E53935" VerticalAlignment="Center"/>
                <!-- 重连: 转圈 (Ellipse 填满 16x16, 几何中心=bounds 中心, 绕 0.5,0.5 旋转必原地; 缺口用 dash) -->
                <Ellipse x:Name="ConnSpinner" Grid.Column="1" Classes="spinner" Width="16" Height="16" Stroke="#888888" StrokeThickness="2" StrokeDashArray="16.5,5.5" StrokeLineCap="Round" RenderTransformOrigin="50%,50%" IsVisible="False" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Border>

        <!-- 操作结果提示(Toast).与左下那条 ConnBanner 刻意错开位置和方向:
             那条讲的是"连接状态"(左下, 横向滑入, 可常驻), 这条讲的是"刚才那步成没成"
             (顶部居中, 纵向落下, 一闪即收).两者同时出现时不会叠在一起, 也不会被看成同一个东西.

             不用 IsVisible 切换, 而是常驻 + 靠 Opacity/位移进出: 元素一直在树里,
             过渡才有起点; 否则同一帧里既显示又改变换, 会直接跳出来而不是滑出来.
             IsHitTestVisible=False, 所以平时透明地待着不挡任何点击. -->
        <Border x:Name="ToastBanner" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,50,0,0" Height="38" Padding="16,0"
                Background="White" CornerRadius="19" BoxShadow="0 2 12 0 #28000000"
                IsHitTestVisible="False" Opacity="0" RenderTransform="translateY(-60px)">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.24"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border x:Name="ToastIcon" Width="18" Height="18" CornerRadius="9" Background="#00A884"
                        VerticalAlignment="Center">
                    <!-- Material 图标是 24x24 坐标系, 必须 Viewbox+Canvas 缩放 -->
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ToastGlyph" Fill="White"
                                  Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock x:Name="ToastText" FontSize="13" Foreground="#222222" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
